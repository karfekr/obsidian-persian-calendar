	},
	"bugs": {
		"url": "https://github.com/karfekr/obsidian-persian-calendar/issues"
	},
	"homepage": "https://github.com/karfekr/obsidian-persian-calendar#readme",
	"keywords": ["obsidian", "plugin", "persian", "jalali", "calendar"],
	"scripts": {
		"lint": "biome check --write .",
		"clean": "node scripts/clean.mjs",
		"version": "node scripts/sync-version.mjs",
		"dev": "node esbuild.config.mjs && node scripts/build-styles.mjs --watch",
		"build": "pnpm run clean && pnpm run build:style && node esbuild.config.mjs production && tsc -noEmit -skipLibCheck",
		"build:style": "node scripts/build-styles.mjs",
		"test": "vitest",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"iran-estehlal": "^1.0.1",
		"persian-holidays": "^1.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/node": "^26.5.0",
		"chokidar": "^5.0.0",
		"cssnano": "^8.0.10",
		"esbuild": "0.28.1",
		"eslint": "^10.14.0",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"obsidian": "^1.13.1",
		"postcss": "^8.5.28",
		"simple-git-hooks": "^2.14.0",
		"tslib": "2.8.1",
		"tsx": "^4.23.13",
		"typescript": "5.9.3",
		"typescript-eslint": "8.70.1",
		"vitest": "^4.1.11"
	},
	"packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint && git add -A",
		"pre-push": "pnpm run build && pnpm run test"
	}
}
