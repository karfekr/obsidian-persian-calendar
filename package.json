	},
	"bugs": {
		"url": "https://github.com/karfekr/obsidian-persian-calendar/issues"
	},
	"homepage": "https://github.com/karfekr/obsidian-persian-calendar#readme",
	"keywords": ["obsidian", "plugin", "persian", "jalali", "calendar"],
	"scripts": {
		"lint": "biome check --write .",
		"clean": "node scripts/clean.mjs",
		"version": "node scripts/sync-version.mjs && pnpm run lint",
		"dev": "node esbuild.config.mjs && node scripts/build-styles.mjs --watch",
		"build": "pnpm run clean && pnpm run build:style && node esbuild.config.mjs production && tsc -noEmit -skipLibCheck",
		"build:style": "node scripts/build-styles.mjs",
		"test": "vitest",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"iran-estehlal": "^1.0.1",
		"persian-holidays": "^1.6.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@types/node": "^26.6.6",
		"chokidar": "^6.0.0",
		"cssnano": "^9.9.0",
		"esbuild": "0.28.2",
		"obsidian": "^1.14.4",
		"postcss": "^8.5.32",
		"simple-git-hooks": "^2.14.0",
		"tslib": "2.9.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint && git add -A",
		"pre-push": "pnpm run build && pnpm run test"
	}
}
